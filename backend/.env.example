# Port the NestJS API listens on
PORT=3001

# Absolute or relative path to the berth schedule CSV file
# The CSV Reader module reads from this location on each request/refresh.
CSV_FILE_PATH=D:\RSGT Berth Sechedule POC\rsgt-berth-schedule
# CSV_FILE_PATH=./data/sample-berth-schedule.csv

# Comma-separated list of origins allowed to call the API (for local dev with Next.js)
CORS_ORIGIN=http://localhost:3000
